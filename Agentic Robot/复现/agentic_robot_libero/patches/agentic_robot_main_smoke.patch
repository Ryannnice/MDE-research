+def parse_manual_plan(raw_plan: Optional[str]) -> list[str]:
+    if not raw_plan:
+        return []
+
+    normalized = raw_plan.replace("\\n", "\n")
+    raw_steps = []
+    for chunk in normalized.split("||"):
+        raw_steps.extend(chunk.splitlines())
+
+    steps = []
+    for raw_step in raw_steps:
+        step = raw_step.strip()
+        if not step:
+            continue
+        step = re.sub(r"^\s*\d+[\).\s-]+", "", step).strip()
+        if step:
+            steps.append(step)
+    return steps
+
+
+def call_llm_planner_for_task(
+    task_description: str,
+    model_name: Optional[str],
+    base_url: Optional[str],
+    api_key_env: Optional[str],
+    planner_style: str,
+    plan_source: str,
+    log_file,
+) -> tuple[list[str], Optional[str]]:
+    if not model_name or not base_url or not api_key_env:
+        return [], None
+    if not os.getenv(api_key_env):
+        print(f"Warning: {plan_source} planner skipped because {api_key_env} is not set.")
+        log_file.write(f"Warning: {plan_source} planner skipped because {api_key_env} is not set.\n")
+        return [], None
+
+    planned_steps = decompose_task_with_llm(
+        task_description,
+        model_name=model_name,
+        base_url=base_url,
+        api_key_env=api_key_env,
+        planner_style=planner_style,
+    )
+    if planned_steps:
+        return planned_steps, plan_source
+    return [], None
+
+
+def build_plan_for_task(cfg: GenerateConfig, original_task_description: str, log_file) -> tuple[list[str], str]:
