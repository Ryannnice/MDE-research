+def run_recovery_lift(env, obs, cfg: GenerateConfig, resize_size, replay_images, log_file, t: int, max_t: int):
+    recovery_action = get_recovery_lift_action(cfg)
+    log_file.write(f"[t={t}] Recovery action: lift gripper for {cfg.recovery_lift_steps} steps.\n")
+    print(f"[t={t}] Recovery action: lift gripper for {cfg.recovery_lift_steps} steps.")
+
+    done = False
+    for _ in range(cfg.recovery_lift_steps):
+        if t >= max_t:
+            break
+        obs, reward, done, info = env.step(recovery_action.tolist())
+        try:
+            replay_images.append(get_libero_image(obs, resize_size))
+        except Exception as exc:
+            log_file.write(f"Warning: failed to append recovery frame: {exc}\n")
+        t += 1
+        if done:
+            break
+
+    return obs, done, t
