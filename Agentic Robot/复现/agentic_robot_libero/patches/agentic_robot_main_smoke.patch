+def _extract_object_and_location(current_subtask_instruction: str) -> tuple[str, str, str]:
+    object_name = "the object"
+    location_name = "the target location"
+    instruction_lower = current_subtask_instruction.lower()
+    verb = ""
+    object_part_raw = ""
+
+    if instruction_lower.startswith("pick up") and (" and place " in instruction_lower or " and put " in instruction_lower):
+        rest = current_subtask_instruction.split("pick up", 1)[1].strip().rstrip(".")
+        connector = " and place " if " and place " in instruction_lower else " and put "
+        picked_obj, place_tail = rest.split(connector, 1)
+        object_name = picked_obj.strip() if picked_obj.strip() else object_name
+        for separator in [" into ", " onto ", " in ", " on "]:
+            if place_tail.startswith(separator.strip() + " "):
+                location_name = f"{separator.strip()} {place_tail[len(separator.strip()):].strip()}"
+                return "place", object_name, location_name
+            if separator in place_tail:
+                placed_obj, loc_temp = place_tail.split(separator, 1)
+                placed_obj = placed_obj.strip()
+                if placed_obj and placed_obj.lower() != "it":
+                    object_name = placed_obj
+                location_name = f"{separator.strip()} {loc_temp.strip()}" if loc_temp.strip() else location_name
+                return "place", object_name, location_name
+        return "complete_task", object_name, location_name
+
+    if instruction_lower.startswith("pick up"):
+        verb = "pick up"
+        try:
+            object_part_raw = current_subtask_instruction.split(verb, 1)[1].strip().rstrip(".")
+        except Exception:
+            pass
+        object_name = object_part_raw if object_part_raw else object_name
+    elif instruction_lower.startswith("place") or instruction_lower.startswith("put"):
+        verb = "place"
+        source_verb = "place" if instruction_lower.startswith("place") else "put"
+        try:
+            object_part_raw = current_subtask_instruction.split(source_verb, 1)[1].strip().rstrip(".")
+        except Exception:
+            pass
+        split_success = False
+        for separator in [" into ", " onto ", " in ", " on "]:
+            if separator in object_part_raw:
+                obj_temp, loc_temp = object_part_raw.split(separator, 1)
+                object_name = obj_temp.strip() if obj_temp.strip() else object_name
+                location_name = f"{separator.strip()} {loc_temp.strip()}" if loc_temp.strip() else location_name
+                split_success = True
+                break
+        if not split_success:
+            object_name = object_part_raw if object_part_raw else object_name
+
+    return verb, object_name, location_name
