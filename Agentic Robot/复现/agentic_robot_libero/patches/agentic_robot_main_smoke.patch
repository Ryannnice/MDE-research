+def heuristic_stuck_detected(eef_positions: collections.deque, consecutive_failed_checks: int, cfg: GenerateConfig) -> bool:
+    if cfg.stuck_detection_mode != "heuristic":
+        return False
+    if consecutive_failed_checks < max(1, cfg.stuck_no_progress_checks):
+        return False
+    if len(eef_positions) < 2:
+        return True
+
+    positions = np.stack(list(eef_positions), axis=0)
+    displacement = np.max(np.linalg.norm(positions - positions[0], axis=1))
+    return displacement < cfg.stuck_eef_delta_threshold
+
