+def _call_api_vlm(
+    image_pair_queue: collections.deque,
+    prompt_text: str,
+    model_name: str,
+    base_url: str,
+    api_key_env: str,
+    max_tokens: int,
+) -> str | None:
+    if not image_pair_queue:
+        print("[API VLM] Warning: image queue is empty.")
+        return None
+
+    api_key = os.getenv(api_key_env)
+    if not api_key:
+        print(f"[API VLM] Warning: {api_key_env} is not set.")
+        return None
+
+    try:
+        from openai import OpenAI
+    except ImportError:
+        print("[API VLM] Error: openai package is not installed.")
+        return None
+
+    content = []
+    for i, (main_img_pil, eih_img_pil) in enumerate(image_pair_queue):
+        content.append({"type": "text", "text": f"Image Pair {i + 1} (Main View):"})
+        content.append({"type": "image_url", "image_url": {"url": _pil_to_data_url(main_img_pil)}})
+        content.append({"type": "text", "text": f"Image Pair {i + 1} (Hand View):"})
+        content.append({"type": "image_url", "image_url": {"url": _pil_to_data_url(eih_img_pil)}})
+    content.append({"type": "text", "text": prompt_text})
+
+    try:
+        client = OpenAI(api_key=api_key, base_url=normalize_openai_base_url(base_url))
+        response = client.chat.completions.create(
+            model=model_name,
+            messages=[{"role": "user", "content": content}],
+            max_tokens=max_tokens,
+            temperature=0,
+        )
+        if not response.choices:
+            return None
+        message = response.choices[0].message
+        return message.content.strip() if message.content else None
+    except Exception as exc:
+        print(f"[API VLM] Error during request: {exc}")
+        traceback.print_exc()
+        return None
