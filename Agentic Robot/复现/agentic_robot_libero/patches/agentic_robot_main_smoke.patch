+        prompt_text = (
+            f"{prompt_prefix}Based only on the image sequence, has '{object_name}' been stably placed "
+            f"{location_name} by the end of the sequence?{target_hint} Answer Yes only if the object is directly "
+            "at the target location, not beside it or merely near it. The gripper may still touch the object. "
+            "Focus on the final object pose and target relation. Answer strictly with 'Yes' or 'No'."
+        )
+    else:
+        prompt_text = (
+            f"{prompt_prefix}Based only on the image sequence and the instruction, has this action been "
+            "successfully completed by the end of the sequence? Answer strictly with 'Yes' or 'No'."
+        )
+
+    response_text = _call_api_vlm(
+        image_pair_queue=image_pair_queue,
+        prompt_text=prompt_text,
+        model_name=model_name,
+        base_url=base_url,
+        api_key_env=api_key_env,
+        max_tokens=10,
+    )
+    if not response_text:
+        return False
+
+    print(f"[API VLM Check] Raw response: '{response_text}'")
+    return response_text.lower().startswith("yes")
+
+
+def diagnose_stuck_with_api_vlm(
+    image_pair_queue: collections.deque,
+    current_subtask_instruction: str,
+    model_name: str,
+    base_url: str,
+    api_key_env: str,
+) -> bool:
+    prompt_text = (
+        f"Observe the image sequence for the robot executing: '{current_subtask_instruction}'. "
+        "Is the robot clearly stuck rather than still making useful progress? "
+        "Examples of stuck include a stationary arm, a failed grasp, repeated oscillation, collision with the table, "
+        "or no visible progress toward the subgoal across the sequence. Answer strictly with 'Stuck' or 'StillTrying'."
+    )
+    response_text = _call_api_vlm(
+        image_pair_queue=image_pair_queue,
+        prompt_text=prompt_text,
+        model_name=model_name,
+        base_url=base_url,
+        api_key_env=api_key_env,
+        max_tokens=12,
+    )
+    if not response_text:
+        return False
+
+    print(f"[API VLM Diagnose] Raw response: '{response_text}'")
+    return response_text.strip().lower().startswith("stuck")
