+def get_recovery_lift_action(cfg: GenerateConfig) -> np.ndarray:
+    action = np.zeros(7, dtype=np.float32)
+    action[2] = cfg.recovery_lift_delta_z
+    action[-1] = -1.0
+    return action
+
