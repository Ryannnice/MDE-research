+def diagnose_stuck_with_qwen_vl(
+    vlm_model,
+    vlm_processor,
+    image_pair_queue: collections.deque,
+    current_subtask_instruction: str,
+) -> bool:
+    if vlm_model is None or vlm_processor is None:
+        print("[VLM Diagnose] Error: VLM model or processor not loaded.")
+        return False
+    if not QWEN_UTILS_AVAILABLE:
+        print(f"[VLM Diagnose] Error: qwen_vl_utils not available: {QWEN_UTILS_IMPORT_ERROR}")
+        return False
+    if not image_pair_queue:
+        print("[VLM Diagnose] Warning: Image queue is empty. Cannot diagnose stuck state.")
+        return False
+
+    try:
+        prompt_text = (
+            f"Observe the image sequence for the robot executing: '{current_subtask_instruction}'. "
+            "Is the robot clearly stuck rather than still making useful progress? "
+            "Examples of stuck include a stationary arm, a failed grasp, repeated oscillation, collision with the table, "
+            "or no visible progress toward the subgoal across the sequence. "
+            "Answer strictly with 'Stuck' or 'StillTrying'."
+        )
+        vlm_response_text = _generate_qwen_vl_response(
+            vlm_model=vlm_model,
+            vlm_processor=vlm_processor,
+            image_pair_queue=image_pair_queue,
+            prompt_text=prompt_text,
+            max_new_tokens=12,
+        )
+        if not vlm_response_text:
+            return False
+        print(f"[VLM Diagnose] Raw response: '{vlm_response_text}'")
+        return vlm_response_text.strip().lower().startswith("stuck")
+    except Exception as e:
+        print(f"Error: Exception during VLM stuck diagnosis (Instruction: '{current_subtask_instruction}'): {e}")
+        traceback.print_exc()
+        return False
