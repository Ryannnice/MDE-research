+import re
+
+import numpy as np
+
+
+def _slug(text: str) -> str:
+    return re.sub(r"[^a-z0-9]+", "_", text.lower()).strip("_")
+
+
+def _strip_articles(text: str) -> str:
+    return re.sub(r"\b(the|a|an)\b", " ", text.lower()).strip()
+
+
+def _base_env(env):
+    return getattr(env, "env", env)
+
+
+def _find_state_name(env, phrase: str, *, prefer_region: str | None = None) -> str | None:
+    clean_phrase = _strip_articles(phrase)
+    phrase_slug = _slug(clean_phrase)
+    aliases = {
+        "stove": "flat_stove",
+        "pot": "moka_pot",
+    }
+    phrase_slug = aliases.get(phrase_slug, phrase_slug)
+
+    base_env = _base_env(env)
+    candidates = list(getattr(base_env, "object_states_dict", {}).keys())
+    if "drawer" in clean_phrase:
+        for drawer_level in ("bottom", "middle", "top"):
+            if drawer_level not in clean_phrase:
+                continue
+            drawer_matches = [
+                name for name in candidates
+                if "cabinet" in name and f"{drawer_level}_region" in name
+            ]
+            if drawer_matches:
+                return sorted(drawer_matches, key=len)[0]
+    if "caddy" in clean_phrase and ("compartment" in clean_phrase or "contain" in clean_phrase):
+        for compartment in ("back", "front", "left", "right"):
+            if compartment not in clean_phrase:
+                continue
+            caddy_matches = [
+                name for name in candidates
+                if "caddy" in name and f"{compartment}_contain_region" in name
+            ]
+            if caddy_matches:
+                return sorted(caddy_matches, key=len)[0]
+
+    if prefer_region:
+        region_matches = [
+            name for name in candidates
+            if phrase_slug in name and prefer_region in name
+        ]
+        if region_matches:
+            return sorted(region_matches, key=len)[0]
+
+    exact_matches = [
+        name for name in candidates
+        if name == phrase_slug or name.startswith(f"{phrase_slug}_")
+    ]
+    non_region_matches = [name for name in exact_matches if "region" not in name]
+    if non_region_matches:
+        return sorted(non_region_matches, key=len)[0]
+    if exact_matches:
+        return sorted(exact_matches, key=len)[0]
+
+    substring_matches = [name for name in candidates if phrase_slug in name]
+    if prefer_region:
+        substring_matches = [name for name in substring_matches if prefer_region in name]
+    if substring_matches:
+        return sorted(substring_matches, key=len)[0]
+    return None
+
+
+def _split_place_instruction(instruction: str) -> tuple[str, str, str] | None:
+    instruction_lower = _strip_articles(instruction)
+    for verb in ("place", "put"):
+        if not instruction_lower.startswith(verb):
+            continue
+        rest = instruction_lower.split(verb, 1)[1].strip()
+        for sep in (" into ", " onto ", " in ", " on "):
+            if sep in rest:
+                obj, target = rest.split(sep, 1)
+                return obj.strip(), sep.strip(), target.strip()
+    return None
+
+
+def _split_pick_and_place_instruction(instruction: str) -> tuple[str, str, str] | None:
+    instruction_lower = _strip_articles(instruction)
+    if not instruction_lower.startswith("pick up"):
+        return None
+
+    rest = instruction_lower.split("pick up", 1)[1].strip()
+    for connector in (" and place ", " and put "):
+        if connector not in rest:
+            continue
+        picked_obj, place_tail = rest.split(connector, 1)
+        picked_obj = picked_obj.strip()
+        place_tail = place_tail.strip()
+        for sep in (" into ", " onto ", " in ", " on "):
+            relation = sep.strip()
+            if place_tail.startswith(f"{relation} "):
+                return picked_obj, relation, place_tail[len(relation):].strip()
+            if sep in place_tail:
+                placed_obj, target = place_tail.split(sep, 1)
+                placed_obj = placed_obj.strip()
+                if placed_obj in ("", "it") or placed_obj in picked_obj or picked_obj in placed_obj:
+                    return picked_obj, relation, target.strip()
+                return placed_obj, relation, target.strip()
+    return None
+
+
+def _eval_predicate(env, state: list[str]) -> bool:
+    base_env = _base_env(env)
+    try:
+        return bool(base_env._eval_predicate(state))
+    except Exception as exc:
+        print(f"[Oracle Verifier] Failed to evaluate predicate {state}: {exc}")
+        return False
+
+
+def _check_pick_up(env, obs, object_name: str) -> bool:
+    obj_state_name = _find_state_name(env, object_name)
+    base_env = _base_env(env)
+    if not obj_state_name or obj_state_name not in base_env.object_states_dict:
+        print(f"[Oracle Verifier] Could not resolve pick-up object: {object_name}")
+        return False
+    if obs is None or "robot0_eef_pos" not in obs:
+        return False
+
+    obj_pos = base_env.object_states_dict[obj_state_name].get_geom_state()["pos"]
+    eef_pos = np.array(obs["robot0_eef_pos"], dtype=np.float32)
+    xy_close = np.linalg.norm(obj_pos[:2] - eef_pos[:2]) < 0.12
+    z_close = abs(obj_pos[2] - eef_pos[2]) < 0.18
+    lifted = obj_pos[2] > 0.88
+    return bool(xy_close and z_close and lifted)
+
+
+def check_completion_with_libero_oracle(env, obs, current_subtask_instruction: str) -> bool:
+    instruction = _strip_articles(current_subtask_instruction)
+
+    if instruction.startswith("turn on"):
+        obj_name = instruction.split("turn on", 1)[1].strip()
+        state_name = _find_state_name(env, obj_name)
+        return _eval_predicate(env, ["turnon", state_name]) if state_name else False
+
+    if instruction.startswith("turn off"):
+        obj_name = instruction.split("turn off", 1)[1].strip()
+        state_name = _find_state_name(env, obj_name)
+        return _eval_predicate(env, ["turnoff", state_name]) if state_name else False
+
+    if instruction.startswith("open"):
+        obj_name = instruction.split("open", 1)[1].strip()
+        state_name = _find_state_name(env, obj_name)
+        return _eval_predicate(env, ["open", state_name]) if state_name else False
+
+    if instruction.startswith("close"):
+        obj_name = instruction.split("close", 1)[1].strip()
+        state_name = _find_state_name(env, obj_name)
+        return _eval_predicate(env, ["close", state_name]) if state_name else False
+
+    parsed_place = _split_pick_and_place_instruction(instruction) or _split_place_instruction(instruction)
+    if parsed_place:
+        obj_name, relation, target_name = parsed_place
+        predicate_name = "in" if relation in ("in", "into") else "on"
+        prefer_region = "contain_region" if predicate_name == "in" else None
+        if "basket" in target_name:
+            predicate_name = "in"
+            prefer_region = "contain_region"
+        if "stove" in target_name:
+            predicate_name = "on"
+            prefer_region = "cook_region"
+
+        obj_state_name = _find_state_name(env, obj_name)
+        target_state_name = _find_state_name(env, target_name, prefer_region=prefer_region)
+        if not obj_state_name or not target_state_name:
+            print(
+                "[Oracle Verifier] Could not resolve place predicate: "
+                f"object={obj_name}->{obj_state_name}, target={target_name}->{target_state_name}"
+            )
+            return False
+        return _eval_predicate(env, [predicate_name, obj_state_name, target_state_name])
+
+    if instruction.startswith("pick up"):
+        obj_name = instruction.split("pick up", 1)[1].strip()
+        return _check_pick_up(env, obs, obj_name)
+
+    print(f"[Oracle Verifier] Unsupported instruction: {current_subtask_instruction}")
+    return False
