+def _pil_to_data_url(image: Image.Image) -> str:
+    image_rgb = image.convert("RGB")
+    buffer = io.BytesIO()
+    image_rgb.save(buffer, format="PNG")
+    encoded = base64.b64encode(buffer.getvalue()).decode("ascii")
+    return f"data:image/png;base64,{encoded}"
