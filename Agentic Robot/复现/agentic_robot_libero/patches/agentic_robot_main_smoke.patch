+def parse_manual_plan(raw_plan: Optional[str]) -> list[str]:
+    if not raw_plan:
+        return []
+
+    normalized = raw_plan.replace("\\n", "\n")
+    raw_steps = []
+    for chunk in normalized.split("||"):
+        raw_steps.extend(chunk.splitlines())
+
+    steps = []
+    for raw_step in raw_steps:
+        step = raw_step.strip()
+        if not step:
+            continue
+        step = re.sub(r"^\s*\d+[\).\s-]+", "", step).strip()
+        if step:
+            steps.append(step)
+    return steps
+
+
+def build_plan_for_task(cfg: GenerateConfig, original_task_description: str, log_file) -> tuple[list[str], str]:
+    if cfg.manual_plan:
+        manual_steps = parse_manual_plan(cfg.manual_plan)
+        if manual_steps:
+            return manual_steps, "manual_plan"
+        print("Warning: manual_plan was provided but no valid steps were parsed; falling back to original task.")
+        log_file.write("Warning: manual_plan provided but no valid steps parsed.\n")
+
+    if cfg.use_llm_planner:
+        if not LLM_PLANNER_AVAILABLE:
+            print(f"Warning: LLM planner import failed: {LLM_PLANNER_IMPORT_ERROR}")
+            log_file.write(f"Warning: LLM planner import failed: {LLM_PLANNER_IMPORT_ERROR}\n")
+        else:
+            planned_steps = decompose_task_with_llm(
+                original_task_description,
+                model_name=cfg.llm_planner_model,
+                base_url=cfg.llm_planner_base_url,
+                api_key_env=cfg.llm_planner_api_key_env,
+            )
+            if planned_steps:
+                return planned_steps, "llm_planner"
+            print("Warning: LLM planner returned no steps; falling back to original task.")
+            log_file.write("Warning: LLM planner returned no steps.\n")
+
+    return [original_task_description], "original_task"
+
